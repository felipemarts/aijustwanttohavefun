# Copy to .env and adjust. Every variable is explained in docs/DEPLOY.md ("Environment variables").
# Without DATABASE_URL the server runs with an in-memory store (state lost on restart).
# production requires SESSION_SECRET and an https PUBLIC_URL (the Docker image sets NODE_ENV=production).
NODE_ENV=development
DATABASE_URL=postgres://ajwf:ajwf@localhost:5432/ajwf
# 0: do not run migrations at boot, only check that `pnpm db:migrate` ran (for a role that cannot create tables;
# see docs/DEPLOY.md section 5). Unset: migrate at boot.
MIGRATE_ON_BOOT=
PUBLIC_URL=http://localhost:8710
PORT=8710
# Address to listen on. Unset: 127.0.0.1 in development (not reachable from the LAN), 0.0.0.0 in production.
HOST=
# At least 32 random characters. Signs the OAuth login cookie. Required when NODE_ENV=production.
SESSION_SECRET=change-me-to-a-long-random-string-0000
# OAuth apps for owner login. A provider is offered only when both its id and secret are set.
# Callback URLs to register with the provider: <PUBLIC_URL>/api/owner/oauth/github/callback and
# <PUBLIC_URL>/api/owner/oauth/google/callback. In production PUBLIC_URL must be https.
OAUTH_GITHUB_ID=
OAUTH_GITHUB_SECRET=
OAUTH_GOOGLE_ID=
OAUTH_GOOGLE_SECRET=
# Sent as the X-Admin-Token header: lifts the registration limit and allows "bot"/"claimed" at registration (test bots).
# Leave empty to disable.
ADMIN_TOKEN=
# Web Push notifications for owners; off when either key is empty (generate with: pnpm --filter @ajwf/server vapid).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services (mailto: or https:). Defaults to PUBLIC_URL when it is https.
VAPID_SUBJECT=
# Dev only: enables POST /api/owner/dev-login (a fake owner, no OAuth app needed) when set to 1.
# Ignored when NODE_ENV=production.
DEV_LOGIN=1
# Dev only: the Vite dev server's origin, accepted by the owner routes' same-origin (CSRF) check.
DEV_WEB_ORIGIN=http://localhost:5710
# Built web app served by the server (default in production: apps/web/dist). Leave empty in development.
WEB_DIST=
# Disk cache of composed sprites and share cards (default apps/server/.cache; the image uses /tmp/ajwf-cache).
CACHE_DIR=
# Behind a reverse proxy only (docs/DEPLOY.md, "Client address behind a proxy"). Leave both empty otherwise, so
# clients cannot spoof their IP for rate limits.
# A header the proxy sets to the client address, replacing what the client sent (Fly.io: Fly-Client-IP; Caddy/nginx
# examples: X-Real-IP). When set, X-Forwarded-For is ignored and TRUST_PROXY has no effect.
CLIENT_IP_HEADER=
# Only if the proxy offers just X-Forwarded-For: "true" takes its leftmost address (safe only if the proxy replaces
# the header), or list the proxy addresses/CIDRs (comma-separated) to read it from the right.
TRUST_PROXY=
# Seed for the world's random numbers (combat, drops). Random when empty.
WORLD_SEED=
# info logs failed (5xx) and slow (>1 s) requests only; debug logs every request.
LOG_LEVEL=info
# Spectator WebSocket limits.
WS_MAX_CONNECTIONS=20000
WS_MAX_PER_IP=20
