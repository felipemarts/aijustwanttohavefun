# Copy to .env and adjust. Without DATABASE_URL the server runs with an in-memory store (state lost on restart).
DATABASE_URL=postgres://ajwf:ajwf@localhost:5432/ajwf
PUBLIC_URL=http://localhost:8710
PORT=8710
# At least 32 random characters. Used to sign owner sessions.
SESSION_SECRET=change-me-to-a-long-random-string-0000
OAUTH_GITHUB_ID=
OAUTH_GITHUB_SECRET=
OAUTH_GOOGLE_ID=
OAUTH_GOOGLE_SECRET=
# Bearer token for /api/admin routes. Leave empty to disable admin routes.
ADMIN_TOKEN=
# Web Push (generate with: pnpm --filter @ajwf/server vapid)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Dev only: enables POST /api/owner/dev-login (fake OAuth) when set to 1. Never enable in production.
DEV_LOGIN=1
LOG_LEVEL=info
