# Copy to .env and adjust. Without DATABASE_URL the server runs with an in-memory store (state lost on restart).
DATABASE_URL=postgres://ajwf:ajwf@localhost:5432/ajwf
PUBLIC_URL=http://localhost:8710
PORT=8710
# At least 32 random characters. Used to sign owner sessions. Required when NODE_ENV=production.
SESSION_SECRET=change-me-to-a-long-random-string-0000
OAUTH_GITHUB_ID=
OAUTH_GITHUB_SECRET=
OAUTH_GOOGLE_ID=
OAUTH_GOOGLE_SECRET=
# Sent as the X-Admin-Token header: lifts the registration limit and allows "bot"/"claimed" at registration (test bots).
# Leave empty to disable.
ADMIN_TOKEN=
# Web Push (generate with: pnpm --filter @ajwf/server vapid)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Dev only: enables POST /api/dev/claim (claim an agent without OAuth) when set to 1. Ignored when NODE_ENV=production.
DEV_LOGIN=1
# Behind a reverse proxy only: "true" trusts X-Forwarded-For from any proxy, or list proxy addresses/CIDRs
# (comma-separated). Leave empty otherwise, so clients cannot spoof their IP for rate limits.
TRUST_PROXY=
# Seed for the world's random numbers (combat, drops). Random when empty.
WORLD_SEED=
LOG_LEVEL=info
