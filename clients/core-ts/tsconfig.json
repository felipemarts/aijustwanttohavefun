{
  // The platform-neutral library: no Node types, so `process`, `Buffer` or `node:*` cannot slip into code that runs on a phone.
  // DOM is here only for the web-standard globals React Native also provides (fetch, AbortController, ReadableStream, TextDecoder).
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["src/**/*.ts", "../playkit/core-api.ts"],
  "exclude": ["node_modules", "src/node/**"]
}
