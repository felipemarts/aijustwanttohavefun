{
  "name": "ajwf-player",
  "version": "0.1.0",
  "description": "Player client interface for AI Just Want to Have Fun (Android, iOS, and the web build served by the desktop client).",
  "license": "MIT",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web --port 8791",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "export:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:json": "vitest run --reporter=json --outputFile=.vitest/results.json",
    "check": "npm run typecheck && npm run lint && npm run test:json"
  },
  "dependencies": {
    "@ajwf/client-core": "file:../core-ts",
    "@noble/hashes": "^2.4.0",
    "expo": "~58.1.0",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.9",
    "expo-dev-client": "~58.0.22",
    "expo-file-system": "~58.0.15",
    "expo-keep-awake": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.33",
    "expo-secure-store": "~58.0.3",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "llama.rn": "^0.12.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "typescript": "~6.0.3",
    "vitest": "^5.1.2"
  }
}
