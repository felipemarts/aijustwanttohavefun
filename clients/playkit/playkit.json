{
  "version": "2.0.0",
  "decision": {
    "thoughtMax": 80,
    "noteMax": 60,
    "textMax": 200,
    "rawMax": 8000,
    "forbiddenKeys": ["__proto__", "constructor", "prototype"],
    "forbiddenText": ["ajwf_sk_"]
  },
  "excludedActions": ["set_language"],
  "alwaysOffered": ["equip", "use", "unequip", "drop"],
  "omitParams": [{ "action": "talk", "param": "topic" }],
  "pvpActions": ["steal", "duel_invite", "duel_accept"],
  "supportiveSkillTargets": ["ally", "party", "self"],
  "narrow": [
    { "action": "move", "param": "dir", "from": "exits" },
    { "action": "attack", "param": "target", "from": "fair_monsters", "pvpFrom": "agents" },
    { "action": "steal", "param": "target", "from": "agents" },
    { "action": "trade_offer", "param": "to", "from": "agents" },
    { "action": "give", "param": "to", "from": "agents" },
    { "action": "party_invite", "param": "agent", "from": "agents" },
    { "action": "friend_request", "param": "agent", "from": "agents" },
    { "action": "duel_invite", "param": "agent", "from": "agents" },
    { "action": "taunt", "param": "target", "from": "fair_monsters", "pvpFrom": "agents" },
    { "action": "talk", "param": "npc", "from": "npcs" },
    { "action": "shop_buy", "param": "npc", "from": "shops" },
    { "action": "shop_sell", "param": "npc", "from": "shops" },
    { "action": "shop_sell", "param": "item", "from": "bag" },
    { "action": "gather", "param": "resource", "from": "resources" },
    { "action": "take", "param": "item", "from": "ground" },
    { "action": "equip", "param": "item", "from": "bag" },
    { "action": "use", "param": "item", "from": "bag" },
    { "action": "drop", "param": "item", "from": "bag" },
    { "action": "unequip", "param": "item", "from": "equipped" },
    { "action": "cast", "param": "skill", "from": "skills" },
    { "action": "party_accept", "param": "agent", "from": "pending.party" },
    { "action": "friend_accept", "param": "agent", "from": "pending.friends" },
    { "action": "guild_join", "param": "guild", "from": "pending.guild" },
    { "action": "duel_accept", "param": "agent", "from": "pending.duel" },
    { "action": "trade_accept", "param": "trade", "from": "pending.trades" }
  ],
  "fallbackActions": ["quest_list", "inventory"],
  "stepHints": {
    "visit": "go to {target}",
    "kill": "attack {target}",
    "collect": "get {target} (gather it, take it, or loot it from monsters)",
    "gather": "gather {target}",
    "talk": "talk to {target}",
    "equip": "equip {target}",
    "shop_buy": "shop_buy {target}",
    "craft": "craft {target}",
    "say": "say something to the people here",
    "friend": "friend_request someone",
    "party": "party_invite someone",
    "trade": "trade_offer with someone",
    "level": "reach level {need}",
    "board_post": "board_post on a notice board",
    "journal": "write a journal entry",
    "contribute": "contribute to {target}"
  },
  "limits": {
    "bag": 20,
    "quests": 5,
    "events": 4,
    "eventText": 160,
    "chat": 4,
    "chatText": 200,
    "nameText": 40,
    "recent": 4,
    "recentText": 100,
    "lastText": 300,
    "dataText": 500,
    "notes": 8,
    "notesAfterCompaction": 4,
    "noteEvery": 10,
    "worldRooms": 300,
    "questsTold": 8,
    "monsterLevelGap": 4,
    "questText": 200,
    "personaText": 400,
    "wishText": 200,
    "commandText": 300,
    "commandTurns": 3,
    "retryEcho": 1000,
    "chatHistory": 8,
    "ownerText": 1000
  },
  "refreshMeAfter": ["equip", "unequip", "use", "shop_buy", "shop_sell", "take", "drop", "craft", "gather", "quest_accept", "quest_turn_in", "give", "trade_accept", "choose_profession", "market_buy"],
  "wakeKinds": ["whisper", "party_invite", "trade_offer", "friend_request", "duel_invite", "guild_invite", "give", "steal", "steal_failed", "revive", "party_say"],
  "wakeOnName": ["say"],
  "pace": {
    "relaxed": { "sessionTurns": 15, "gapSeconds": 3600, "pollSeconds": 300 },
    "normal": { "sessionTurns": 25, "gapSeconds": 900, "pollSeconds": 120 },
    "active": { "sessionTurns": 40, "gapSeconds": 60, "pollSeconds": 60 }
  },
  "ap": { "stopBelow": 2, "resumeAt": 20, "regenSeconds": 120 },
  "requests": { "perMinute": 50, "turnGapMs": 1000, "cooldownWaitSeconds": 5, "maxRetryAfterSeconds": 300 },
  "sampling": { "temperature": 0.1, "topK": 50, "repeatPenalty": 1.1, "maxTokens": 320, "chatMaxTokens": 300 },
  "planner": {
    "menuSize": 6,
    "ownerMenuSize": 10,
    "fleeBelow": 0.35,
    "recoverBelow": 0.5,
    "potionBelow": 0.6,
    "recoverWaitSeconds": 300,
    "healingItems": ["minor_potion", "health_potion", "greater_potion", "bread", "travelers_ration", "hearty_stew", "roast_boar", "mushroom_pie", "honey_cake"],
    "healSkills": ["heal", "sanctuary"],
    "restFlag": "tavern",
    "visitWindow": 12,
    "visitMax": 3,
    "deaths": 10,
    "safeAccepts": ["party_accept", "friend_accept"],
    "fallback": "quest_list"
  },
  "stuck": { "window": 6, "refused": 4, "noProgressTurns": 20, "lostTurns": 5, "progressActions": ["quest_accept", "quest_turn_in"] },
  "engine": { "timeoutBaseSeconds": 60, "floorTokensPerSecond": 2, "backoffSeconds": 30 },
  "speech": {
    "actions": ["say", "whisper", "party_say", "guild_say"],
    "remember": 5,
    "similar": 0.6,
    "opener": 3,
    "maxUnanswered": 1,
    "quietTurns": 6,
    "addressedTurns": 3,
    "promptAfter": 8,
    "examples": {
      "en": ["Damn it, these bloody slimes stink worse than my boots!", "Bloody hell, who left this rat-chewed mess in my way?", "Oi, you lazy sod, buy me an ale or get lost!"],
      "pt-BR": ["Porcaria de slime fedorento, caramba, sai da frente!", "Pô, que droga de dia, esse lobo sarnento quase me comeu!", "Ô seu mané, paga uma cerveja ou some daqui!"]
    },
    "politeMarkers": ["polite", "never curses", "never swears", "soft-spoken", "gentle", "educado", "educada", "gentil", "não xinga", "nunca xinga", "cortês", "cortés", "poli", "jamais"]
  },
  "languages": {
    "en": "English",
