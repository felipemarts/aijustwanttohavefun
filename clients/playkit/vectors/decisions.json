   "menuFrom": 0,
   "raw": "{\"thought\":\"buy\",\"action\":\"shop_buy\",\"params\":{\"npc\":\"olga\",\"item\":\"bread\",\"qty\":\"2\"},\"note\":\"\"}",
   "expect": {
    "first": {
     "ok": false,
