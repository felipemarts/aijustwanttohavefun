{
 "about": "Model answers. For each case: menu = BuildTurn(schema.json, prompts.json cases[menuFrom].input).menu. Decide(raw) gives expect.first (a decision or a problem). When retry is present, the turn resolves as in the README: expect.final says which answer was used (first, retry, fallback or none) and the decision.",
 "cases": [
  {
   "name": "clean answer",
   "menuFrom": 0,
   "raw": "{\"thought\": \"Olga has a quest for me.\", \"action\": \"talk\", \"params\": {\"npc\": \"olga\"}, \"note\": \"\"}",
   "expect": {
    "first": {
     "ok": false,
     "problem": "action: must be one of: \"quest_accept\""
    }
   }
  },
  {
   "name": "prose and a code fence around the object",
   "menuFrom": 0,
   "raw": "Sure! Here is my move:\n```json\n{\"thought\":\"Go to the tavern\",\"action\":\"move\",\"params\":{\"dir\":\"north\"},\"note\":\"The tavern is north of the square.\"}\n```\nGood luck!",
   "expect": {
    "first": {
     "ok": false,
     "problem": "action: must be one of: \"quest_accept\""
    }
   }
  },
  {
   "name": "a reasoning block before the object",
   "menuFrom": 0,
   "raw": "<think>\nThe quest says visit the tavern {north}.\n</think>\n{\"thought\":\"Tavern first.\",\"action\":\"move\",\"params\":{\"dir\":\"north\"},\"note\":\"\"}",
   "expect": {
    "first": {
     "ok": false,
     "problem": "action: must be one of: \"quest_accept\""
    }
   }
  },
  {
   "name": "an unclosed reasoning block",
   "menuFrom": 0,
   "raw": "<think>I should go north {\"action\":\"move\"}",
   "expect": {
    "first": {
     "ok": false,
     "problem": "the answer is not one valid JSON object"
    }
   }
  },
  {
   "name": "thought and note missing, params missing for an action without params",
   "menuFrom": 1,
   "raw": "{\"action\": \"flee\"}",
   "expect": {
    "first": {
     "ok": true,
     "decision": {
      "thought": "",
      "action": "flee",
      "params": {},
      "note": ""
     }
    }
   }
  },
  {
   "name": "a long thought and note are clipped, not refused",
   "menuFrom": 0,
   "raw": "{\"thought\": \"\", \"action\": \"quest_list\", \"params\": {}, \"note\": \"yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy\"}",
   "expect": {
    "first": {
     "ok": false,
     "problem": "action: must be one of: \"quest_accept\""
    }
   }
  },
  {
   "name": "trailing comma",
   "menuFrom": 0,
   "raw": "{\"thought\":\"hi\",\"action\":\"move\",\"params\":{\"dir\":\"north\",},\"note\":\"\"}",
   "expect": {
    "first": {
     "ok": false,
     "problem": "the answer is not one valid JSON object"
    }
   }
  },
  {
   "name": "duplicate key",
   "menuFrom": 0,
   "raw": "{\"thought\":\"hi\",\"action\":\"move\",\"action\":\"talk\",\"params\":{\"dir\":\"north\"},\"note\":\"\"}",
   "expect": {
    "first": {
     "ok": false,
     "problem": "the answer is not one valid JSON object"
    }
   }
  },
  {
   "name": "no JSON at all",
   "menuFrom": 0,
   "raw": "I will walk north to the tavern.",
   "expect": {
    "first": {
     "ok": false,
     "problem": "the answer is not one valid JSON object"
    }
   }
  },
  {
   "name": "an action that is not on the menu",
   "menuFrom": 0,
   "raw": "{\"thought\":\"Attack!\",\"action\":\"attack\",\"params\":{\"target\":\"olga\"},\"note\":\"\"}",
   "expect": {
    "first": {
     "ok": false,
     "problem": "action: must be one of: \"quest_accept\""
    }
   }
  },
  {
