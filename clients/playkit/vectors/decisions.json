  {
   "name": "the PvP-free menu has no agent to attack",
   "menuFrom": 1,
   "raw": "{\"thought\":\"Hit Mallory\",\"action\":\"attack\",\"params\":{\"target\":\"Mallory\"},\"note\":\"\"}",
