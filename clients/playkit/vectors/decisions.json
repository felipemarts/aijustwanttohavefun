   "expect": {
    "first": {
     "ok": false,
     "problem": "action: must be one of: \"quest_accept\""
    }
   }
  },
  {
   "name": "a required param missing",
   "menuFrom": 0,
   "raw": "{\"thought\":\"Talk\",\"action\":\"talk\",\"params\":{},\"note\":\"\"}",
   "expect": {
    "first": {
     "ok": false,
     "problem": "action: must be one of: \"quest_accept\""
    }
   }
  },
  {
   "name": "an extra param",
   "menuFrom": 0,
   "raw": "{\"thought\":\"Talk\",\"action\":\"talk\",\"params\":{\"npc\":\"olga\",\"topic2\":\"x\"},\"note\":\"\"}",
