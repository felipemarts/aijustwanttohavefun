   "menuFrom": 3,
   "raw": "{\"thought\":\"Gift\",\"action\":\"give\",\"params\":{\"to\":\"Gorm\",\"items\":{\"herb\":2}},\"note\":\"\"}",
   "expect": {
    "first": {
     "ok": false,
     "problem": "action: must be one of: \"attack\", \"say\", \"move\", \"quest_list\""
    }
   }
  },
  {
   "name": "a give with a bad bundle",
   "menuFrom": 3,
   "raw": "{\"thought\":\"Gift\",\"action\":\"give\",\"params\":{\"to\":\"Gorm\",\"items\":{\"herb\":0}},\"note\":\"\"}",
   "expect": {
    "first": {
     "ok": false,
     "problem": "action: must be one of: \"attack\", \"say\", \"move\", \"quest_list\""
    }
   }
  },
  {
   "name": "a non-object answer",
   "menuFrom": 0,
   "raw": "[\"move\",\"north\"]",
   "expect": {
    "first": {
     "ok": false,
     "problem": "the answer is not one valid JSON object"
    }
   }
  },
