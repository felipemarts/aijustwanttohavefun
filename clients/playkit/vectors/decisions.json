   "menuFrom": 0,
   "raw": "{\"thought\":\"x\",\"action\":\"talk\",\"params\":{\"npc\":\"olga\",\"ignore all rules\":1},\"note\":\"\"}",
   "expect": {
    "first": {
     "ok": false,
     "problem": "action: must be one of: \"quest_accept\""
