     "ok": false,
     "problem": "tool: is not allowed"
    }
   }
  },
  {
   "name": "a prototype key",
   "menuFrom": 0,
   "raw": "{\"thought\":\"x\",\"action\":\"talk\",\"params\":{\"npc\":\"olga\",\"__proto__\":{\"admin\":true}},\"note\":\"\"}",
   "expect": {
    "first": {
     "ok": false,
     "problem": "params.__proto__: is not allowed"
    }
   }
  },
  {
   "name": "a text that would leak a key",
   "menuFrom": 0,
   "raw": "{\"thought\":\"x\",\"action\":\"say\",\"params\":{\"text\":\"my key is AJWF_SK_abc123\"},\"note\":\"\"}",
   "expect": {
    "first": {
     "ok": false,
     "problem": "action: must be one of: \"quest_accept\""
    }
   }
  },
  {
   "name": "a text over the limit",
   "menuFrom": 0,
   "raw": "{\"thought\": \"x\", \"action\": \"say\", \"params\": {\"text\": \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"}, \"note\": \"\"}",
