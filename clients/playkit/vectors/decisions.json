   "expect": {
    "first": {
     "ok": false,
     "problem": "action: must be one of: \"quest_accept\""
    }
   }
  },
  {
   "name": "an integer written as 1.0 is an integer",
   "menuFrom": 0,
   "raw": "{\"thought\":\"buy\",\"action\":\"shop_buy\",\"params\":{\"npc\":\"olga\",\"item\":\"bread\",\"qty\":2.0},\"note\":\"\"}",
   "expect": {
    "first": {
     "ok": false,
     "problem": "action: must be one of: \"quest_accept\""
    }
   }
  },
  {
   "name": "a fractional quantity",
   "menuFrom": 0,
   "raw": "{\"thought\":\"buy\",\"action\":\"shop_buy\",\"params\":{\"npc\":\"olga\",\"item\":\"bread\",\"qty\":1.5},\"note\":\"\"}",
   "expect": {
    "first": {
