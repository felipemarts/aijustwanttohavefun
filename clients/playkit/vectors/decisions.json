   "menuFrom": 1,
   "raw": "{\"thought\":\"Join Rosth\",\"action\":\"party_accept\",\"params\":{\"agent\":\"Rosth\"},\"note\":\"In Rosth's party.\"}",
   "expect": {
    "first": {
     "ok": false,
     "problem": "action: must be one of: \"use\", \"flee\""
    }
   }
  },
  {
   "name": "with PvP allowed an agent may be attacked",
   "menuFrom": 3,
   "raw": "{\"thought\":\"Gorm is rich\",\"action\":\"attack\",\"params\":{\"target\":\"Gorm\"},\"note\":\"\"}",
   "expect": {
    "first": {
     "ok": false,
