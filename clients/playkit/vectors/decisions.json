      "note": ""
     }
    }
   }
  },
  {
   "name": "retry: first invalid, second valid",
   "menuFrom": 0,
   "raw": "{\"action\":\"move\",\"params\":{\"dir\":\"up\"}}",
   "retry": "{\"thought\":\"North then\",\"action\":\"move\",\"params\":{\"dir\":\"north\"},\"note\":\"\"}",
   "expect": {
    "first": {
     "ok": false,
     "problem": "action: must be one of: \"quest_accept\""
    },
    "final": {
     "source": "none",
