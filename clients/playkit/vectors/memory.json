   "expect": {
    "messages": [
     {
      "role": "user",
      "content": "You keep the memory of Pip, a character in a text MMORPG. Merge the notes below into at most 4 short notes, each under 60 characters. Keep goals, people, places and promises. Drop what is done or no longer useful.\n\nNotes:\n- n1\n- n2\n- n3\n- n4\n- n5\n- n6\n- n7\n- n8\n- Wolves hunt in packs\n\nAnswer with JSON: {\"notes\": [\"...\", \"...\"]}"
     }
    ],
    "schema": {
     "type": "object",
     "properties": {
      "notes": {
       "type": "array",
       "items": {
        "type": "string",
        "maxLength": 60
