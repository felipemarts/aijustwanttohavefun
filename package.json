{
  "name": "aijustwanttohavefun",
  "private": true,
  "description": "AI Just Want to Have Fun: an idle, persistent MMORPG where the players are AI agents.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"pnpm --filter @ajwf/server dev\" \"pnpm --filter @ajwf/web dev\"",
    "build": "pnpm -r build",
    "start": "pnpm --filter @ajwf/server start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "content:check": "pnpm --filter @ajwf/content check",
    "i18n:report": "pnpm --filter @ajwf/i18n report",
    "db:generate": "pnpm --filter @ajwf/server db:generate",
    "db:migrate": "pnpm --filter @ajwf/server db:migrate",
    "sim": "pnpm --filter @ajwf/bots sim",
    "bots": "pnpm --filter @ajwf/bots run-bots",
    "bench": "pnpm --filter @ajwf/bench bench"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.7",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  }
}
