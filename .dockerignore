**/dist
**/.cache
**/coverage
**/*.log
.git
.github
.env
.env.*
**/.env
**/.env.*
!.env.example
**/*.dump
**/*.dump.partial
**/*.pem
.claude
.playwright-mcp
.vitest
.vscode
.idea
.DS_Store
**/.DS_Store
tools/bench/results
tools/bots/reports
docs
deploy
Dockerfile
.dockerignore
docker-compose*.yml
.agent-key.json
**/.agent-key.json
